<?xml version="1.0" encoding="UTF-8"?>
<!-- Logger simples de console para o guia. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Codigo da aplicacao em INFO. -->
    <logger name="com.example.ibmmq" level="INFO"/>

    <!-- Reduz ruido do cliente IBM MQ. -->
    <logger name="com.ibm.mq" level="WARN"/>
    <logger name="com.ibm.msg" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
