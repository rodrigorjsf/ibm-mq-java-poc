<?xml version="1.0" encoding="UTF-8"?>
<!-- Logger simples de console para o guia. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- %X{messageId} and %X{correlationId} expose the MDC ids set during the COA/COD flow,
             making a single message traceable end-to-end in the console (grep by id).
             %replace suppresses the empty bracket segment on lines outside the COA/COD flow
             (m1: no more "[messageId= correlationId=]" noise on startup/Micronaut lines)
             while preserving the full ids on flow lines. The regex matches exactly the
             all-empty form (including the trailing space) and collapses it to nothing. -->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36}%replace( [messageId=%X{messageId} correlationId=%X{correlationId}]){'^ \[messageId= correlationId=\]$',''} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Codigo da aplicacao em INFO. -->
    <logger name="com.example.ibmmq" level="INFO"/>

    <!-- Reduz ruido do cliente IBM MQ. -->
    <logger name="com.ibm.mq" level="WARN"/>
    <logger name="com.ibm.msg" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
