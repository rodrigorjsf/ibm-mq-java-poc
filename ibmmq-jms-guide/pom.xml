<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>ibmmq-jms-guide</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>ibmmq-jms-guide</name>
    <description>Micronaut 4 + IBM MQ (JMS 2.0 / javax.jms) — demonstracao de relatorios COA/COD</description>

    <properties>
        <!-- Producao roda em Java 25 (LTS); o bytecode gerado tem como alvo o release 25 (Amazon Corretto 25).
             Supersede a P1 do brief (Java 21) — ver docs/adr/0001-java-25-runtime.md. -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versoes travadas (ver fact sheet Fase A). micronaut-platform 4.9.9 NAO existe:
             a linha 4.9.x do BOM termina em 4.9.4. -->
        <micronaut.version>4.9.4</micronaut.version>
        <micronaut.maven.plugin.version>4.11.6</micronaut.maven.plugin.version>
        <!-- Versao do Micronaut Data alinhada pelo BOM micronaut-platform 4.9.4 (importa micronaut-data-bom
             4.13.5). Fixada explicitamente porque os annotationProcessorPaths do maven-compiler-plugin NAO
             resolvem versoes geridas por <dependencyManagement> — o path do micronaut-data-processor precisa
             da versao literal (espelha o micronaut-inject-java, que ja fixa ${micronaut.version}). A
             dependencia de runtime micronaut-data-jdbc continua sem versao (o BOM a gere). -->
        <micronaut.data.version>4.13.5</micronaut.data.version>
        <!-- Versao do Micronaut Validation alinhada pelo BOM micronaut-platform 4.9.4 (que define
             micronaut.validation.version = 4.10.0). Fixada explicitamente porque os annotationProcessorPaths
             do maven-compiler-plugin NAO resolvem versoes geridas por <dependencyManagement> — o path do
             micronaut-validation-processor precisa da versao literal (espelha o micronaut-data-processor
             acima). A dependencia de runtime micronaut-validation continua sem versao (o BOM a gere). -->
        <micronaut.validation.version>4.10.0</micronaut.validation.version>

        <!-- Cliente IBM MQ javax.jms / JMS 2.0. -->
        <ibm.mq.version>9.4.5.0</ibm.mq.version>
        <!-- Pool JMS na linha javax (2.x ainda e javax.jms; 3.x = jakarta). -->
        <pooled.jms.version>2.0.9</pooled.jms.version>

        <jackson.version>2.18.2</jackson.version>

        <!-- Driver Postgres do store de correlacao COMPARTILHADO (harness k3s, correlation.store=jdbc).
             Versao FIXADA explicitamente — nao assumimos que o BOM do Micronaut a gerencie. O pool de
             conexoes (HikariCP) vem de micronaut-jdbc-hikari, cuja versao e alinhada pelo BOM. -->
        <postgresql.version>42.7.4</postgresql.version>

        <!-- Versoes de teste. -->
        <junit.version>5.11.4</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <assertj.version>3.27.3</assertj.version>
        <!-- Testcontainers 2.x (major novo; docker-java moderno, compativel com Docker engine 29.x).
             Core 2.0.5 + modulo oficial IBM (MQContainer) 2.0.3. -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <ibm.mq.testcontainer.version>2.0.3</ibm.mq.testcontainer.version>

        <!-- Aplicacao Micronaut: nome da classe principal. -->
        <exec.mainClass>com.example.ibmmq.Application</exec.mainClass>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM da plataforma Micronaut: alinha versoes de todos os modulos micronaut-*. -->
            <dependency>
                <groupId>io.micronaut.platform</groupId>
                <artifactId>micronaut-platform</artifactId>
                <version>${micronaut.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ===================== Micronaut (apenas DI / ciclo de vida) ===================== -->
        <!-- Injecao de dependencia e processamento de @ConfigurationProperties/@Factory. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-inject</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- jakarta.annotation-api: fornece @PostConstruct/@PreDestroy (JSR-250), usados pelos beans de
             ciclo de vida do harness (AbstractHarnessRunner, JdbcCorrelationStore). Provavelmente ja vem
             transitivo via micronaut-inject; declarado explicitamente (sem versao — alinhada pelo BOM
             micronaut-platform) para garantir a presenca em tempo de compilacao. -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- Runtime: ApplicationContext, bootstrap, suporte a application.yml. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-runtime</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- Bean validation (Micronaut Validation / jakarta.validation). Enables @Validated +
             @Min/@Max/@NotBlank on MqProperties so misconfiguration is rejected FAIL-FAST at context
             startup (issue #27 / ADR-0011), not deferred to connect time. Version is aligned by the
             micronaut-platform BOM (resolves to micronaut.validation.version). The matching
             annotation processor sits on the maven-compiler-plugin annotationProcessorPaths below. -->
        <dependency>
            <groupId>io.micronaut.validation</groupId>
            <artifactId>micronaut-validation</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- ===================== JSON ===================== -->
        <!-- jackson-databind puro (sem serde): evita acoplar o processador serde e
             a necessidade de @Serdeable nos records. Usamos new ObjectMapper() / @Singleton. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- ===================== IBM MQ + Pool JMS ===================== -->
        <!-- allclient = javax.jms (JMS 2.0). Traz com.ibm.mq.*, com.ibm.msg.client.*,
             com.ibm.mq.constants.* (CMQC/MQConstants) e a javax.jms-api 2.0.1 transitiva. -->
        <dependency>
            <groupId>com.ibm.mq</groupId>
            <artifactId>com.ibm.mq.allclient</artifactId>
            <version>${ibm.mq.version}</version>
            <scope>compile</scope>
        </dependency>
        <!-- Pool de conexoes JMS (javax). Classe: org.messaginghub.pooled.jms.JmsPoolConnectionFactory. -->
        <dependency>
            <groupId>org.messaginghub</groupId>
            <artifactId>pooled-jms</artifactId>
            <version>${pooled.jms.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- ===================== Store de correlacao COMPARTILHADO (JDBC/Postgres) ===================== -->
        <!-- Habilita o JdbcCorrelationStore (gated por correlation.store=jdbc), usado pelo harness k3s
             para reconciliar correlacao cluster-wide entre pods consumidores concorrentes (AC2).
             micronaut-jdbc-hikari fornece o bean javax.sql.DataSource (HikariCP) a partir de uma config
             datasources.* (dirigida por env no harness; ausente do application.yml para manter o contexto
             de teste inerte). A versao e alinhada pelo BOM micronaut-platform.
             O JdbcCorrelationStore usa JDBC puro (PreparedStatement) — sem Micronaut Data — para evitar
             acoplar um annotation-processor adicional ao compilador. -->
        <dependency>
            <groupId>io.micronaut.sql</groupId>
            <artifactId>micronaut-jdbc-hikari</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- Micronaut Data JDBC: runtime support for @MappedEntity / @JdbcRepository — the read/write
             split persistence of the APPEND-ONLY delivery_report audit table (issue #40). Version is
             aligned by the micronaut-platform BOM. Scope is COMPILE (not runtime) on purpose: the
             maven-dependency-plugin copies includeScope=runtime into target/dependency for the thin-jar
             Docker launch, and compile ⊃ runtime, so this jar lands there. (The annotation PROCESSOR
             below is build-only and is NOT copied — it sits on annotationProcessorPaths.)
             NOTE: this is the ONLY Micronaut Data surface in the project. JdbcCorrelationStore stays raw
             JDBC on the writer/default datasource — only the new audit read-model uses Micronaut Data. -->
        <dependency>
            <groupId>io.micronaut.data</groupId>
            <artifactId>micronaut-data-jdbc</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- Driver JDBC do Postgres (versao fixada acima). Em producao prefira um backend transacional
             para o outbox; aqui o Postgres atende ao harness e ao padrao pending_message. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- ===================== Logging ===================== -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===================== Testes ===================== -->
        <dependency>
            <groupId>io.micronaut.test</groupId>
            <artifactId>micronaut-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- AssertJ: assercoes fluentes (assertThat) — convencao de teste do projeto
             (ver src/test/CLAUDE.md). Preferida sobre org.junit.jupiter.api.Assertions. -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x + modulo oficial IBM (classe com.ibm.mq.testcontainers.MQContainer).
             O modulo 2.0.3 traz o core 2.0.3 transitivamente; declaramos o core 2.0.5 diretamente para
             fixa-lo via "nearest wins" (override). O lifecycle do container e manual (@BeforeAll/@AfterAll),
             entao NAO precisamos do modulo org.testcontainers:junit-jupiter. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.ibm.mq</groupId>
            <artifactId>mq-java-testcontainer</artifactId>
            <version>${ibm.mq.testcontainer.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- NOTA: os ITs de persistencia do delivery_report (issue #40) usam o GenericContainer do CORE
             (org.testcontainers.containers.GenericContainer) com a imagem postgres:16-alpine / bitnami,
             construindo a URL JDBC a partir da porta mapeada. O Testcontainers 2.x NAO publica mais um
             modulo `org.testcontainers:postgresql` separado (o PostgreSQLContainer dedicado nao existe na
             linha 2.0.5 que travamos pela compatibilidade com Docker engine 29.x — ver CLAUDE.md), entao
             ficamos no GenericContainer do core (mesmo padrao do CoaCodEndToEndIT com o MQContainer). -->
        <!-- (sem dependencia adicional: GenericContainer/Network/Wait vivem no core 2.0.5 ja declarado) -->
        <!-- docker-java-transport-zerodep 3.7.1 (trazido pelo Testcontainers 2.0.5) referencia
             org.apache.commons.codec.Charsets, classe removida no commons-codec 1.17+. Fixamos a
             ultima versao que ainda a possui (1.16.1) para o container subir no teste de integracao. -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.16.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin Micronaut: empacotamento/execucao. Linha 4.x para Micronaut 4.9.x. -->
            <plugin>
                <groupId>io.micronaut.maven</groupId>
                <artifactId>micronaut-maven-plugin</artifactId>
                <version>${micronaut.maven.plugin.version}</version>
            </plugin>

            <!-- maven-dependency-plugin: copia TODAS as dependencias de runtime para target/dependency/
                 na fase package. O jar produzido e "thin" (sem classpath embutido) — sem isto, um
                 `java -jar` falha por classe nao encontrada. O Dockerfile entao lanca a app com
                 `-cp "target/classes:target/dependency/*"` (sem maven-shade, que exigiria merge de
                 META-INF/services para o DI do Micronaut funcionar). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dependency</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Compilador: release 25 + processadores de anotacao do Micronaut. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <!-- Gera os metadados de DI/bean do Micronaut em tempo de compilacao. -->
                        <path>
                            <groupId>io.micronaut</groupId>
                            <artifactId>micronaut-inject-java</artifactId>
                            <version>${micronaut.version}</version>
                        </path>
                        <!-- Micronaut Data: gera os metadados das repositories (@JdbcRepository) e
                             entidades (@MappedEntity) em tempo de compilacao. Coexiste com o
                             micronaut-inject-java acima — AMBOS sao necessarios (adicionar um nao remove
                             o outro). Apenas build-time: NAO vira dependencia de runtime. A versao e
                             alinhada pelo modulo micronaut-data (BOM micronaut-platform). -->
                        <path>
                            <groupId>io.micronaut.data</groupId>
                            <artifactId>micronaut-data-processor</artifactId>
                            <version>${micronaut.data.version}</version>
                        </path>
                        <!-- Micronaut Validation: gera os metadados de bean-validation (@Validated +
                             @Min/@Max/@NotBlank em MqProperties) em tempo de compilacao, habilitando a
                             validacao FAIL-FAST no startup do contexto (issue #27 / ADR-0011). Coexiste com
                             os processadores acima — AMBOS sao necessarios. Apenas build-time: NAO vira
                             dependencia de runtime. A versao e literal porque os annotationProcessorPaths
                             nao herdam o <dependencyManagement> do BOM (mesmo motivo do data-processor). -->
                        <path>
                            <groupId>io.micronaut.validation</groupId>
                            <artifactId>micronaut-validation-processor</artifactId>
                            <version>${micronaut.validation.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Surefire: testes unitarios (*Test.java). NAO roda *IT.java (vai para o failsafe).
                 O argLine enable-native-access silencia o aviso de native-access do cliente MQ
                 (System.loadLibrary) sob Corretto 25. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Failsafe: testes de integracao (*IT.java), ligado a integration-test/verify.
                 Requer Docker (Testcontainers). Mesmo argLine de native-access. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- O failsafe roda TODOS os *IT.java por padrao. O IT de replicacao fisica
                         (DeliveryReportReplicationIT, @Tag("replication")) sobe DOIS containers Postgres
                         (primary + standby por streaming replication) e e inerentemente sensivel a lag —
                         caro e potencialmente instavel para a gate `verify` do CI. Excluimo-lo do `verify`
                         padrao por tag; rode-o sob demanda com `mvn verify -Preplication` (o perfil abaixo
                         limpa este excludedGroups). O IT de persistencia DETERMINISTICO
                         (DeliveryReportPersistenceIT) roda num UNICO container e PERMANECE no `verify`.
                         Os cenarios LENTOS/sensiveis a timing do Grupo A (ScenarioMatrixSlowIT,
                         @Tag("scenario") — Expiration/Reconnect/PooledJmsInvalidation) tambem ficam FORA do
                         `verify` padrao: eles esperam TTL expirar e/ou dao bounce no Queue Manager
                         (endmqm/strmqm dentro do container) e fazem poll ate ele voltar — caros e
                         potencialmente instaveis para a gate. Rode-os sob demanda com `mvn verify -Pscenarios`
                         (o perfil abaixo inverte o filtro). Os cenarios DETERMINISTICOS do Grupo A
                         (ScenarioMatrixIT) NAO sao taggeados e PERMANECEM no `verify`.
                         A EVIDENCIA de Virtual Threads do Grupo B (VirtualThreadsEvidenceIT, @Tag("vt") —
                         padrao certo vs errado de concorrencia + fronteira de pinning JEP-491) tambem fica
                         FORA do `verify` padrao: ela roda micro-medicoes de concorrencia (bounded) e grava
                         JFR programatico — util como evidencia, mas nao deterministica o bastante para a
                         gate. Rode-a sob demanda com `mvn verify -Pvt`. -->
                    <excludedGroups>replication,scenario,vt</excludedGroups>
                    <environmentVariables>
                        <!-- Docker 25+ (engine 29.x neste ambiente) exige API >= 1.40 e dropou versoes
                             antigas. O docker-java embutido no Testcontainers 1.20.x negocia para uma
                             versao fora dessa faixa, e o daemon responde HTTP 400 -> Testcontainers
                             reporta "Could not find a valid Docker environment". Fixar a API numa versao
                             suportada [1.40..1.54] resolve. Para Docker antigo (<25), ajuste/remova. -->
                        <DOCKER_API_VERSION>1.44</DOCKER_API_VERSION>
                    </environmentVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Perfil opt-in para o IT de replicacao fisica Postgres (primary + standby).
             Por que existe: o `verify` padrao EXCLUI o grupo "replication" (ver o failsafe acima) porque
             o teste de dois containers com streaming replication e caro e sensivel a lag — impróprio para
             a gate de CI. Este perfil INVERTE o filtro: roda APENAS os ITs com @Tag("replication")
             (<groups>) e sobrescreve o <excludedGroups> herdado com um sentinel (veja a nota abaixo), de
             modo que `mvn verify -Preplication` exercita o read-from-reader com poll-with-timeout sob
             demanda. Espelha o padrao -Pload descrito em src/test/CLAUDE.md. -->
        <profile>
            <id>replication</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <!-- Run ONLY the replication group. An EMPTY <excludedGroups></excludedGroups>
                                 does NOT override the base <excludedGroups>replication</excludedGroups>:
                                 Maven merges plugin configuration rather than blanking an inherited value, so
                                 both filters would apply and run ZERO tests. The sentinel "none" matches no
                                 @Tag, overriding the inherited exclusion so only @Tag("replication") ITs run. -->
                            <groups>replication</groups>
                            <excludedGroups>none</excludedGroups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Perfil opt-in para os cenarios LENTOS/sensiveis a timing do Grupo A (ScenarioMatrixSlowIT,
             @Tag("scenario") — Expiration/Reconnect/PooledJmsInvalidation). Por que existe: o `verify`
             padrao EXCLUI o grupo "scenario" (ver o failsafe acima) porque esses cenarios esperam um TTL
             expirar e/ou dao bounce no Queue Manager (endmqm -i / strmqm DENTRO do container, preservando a
             porta mapeada) e fazem poll ate ele voltar — caros e potencialmente instaveis para a gate de CI.
             Este perfil INVERTE o filtro: roda APENAS os ITs com @Tag("scenario") (<groups>) e sobrescreve o
             <excludedGroups> herdado com o mesmo sentinel "none" (uma tag inexistente) do perfil
             `replication` — um <excludedGroups></excludedGroups> VAZIO nao sobrescreveria o valor herdado
             "replication,scenario" (o Maven faz merge da config do plugin, nao blanking), entao ambos os
             filtros se aplicariam e ZERO testes rodariam. Assim `mvn verify -Pscenarios` exercita os tres
             cenarios lentos sob demanda. Espelha o padrao do perfil `replication` acima. -->
        <profile>
            <id>scenarios</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <!-- Run ONLY the scenario group. An EMPTY <excludedGroups></excludedGroups>
                                 does NOT override the base <excludedGroups>replication,scenario</excludedGroups>:
                                 Maven merges plugin configuration rather than blanking an inherited value, so
                                 both filters would apply and run ZERO tests. The sentinel "none" matches no
                                 @Tag, overriding the inherited exclusion so only @Tag("scenario") ITs run. -->
                            <groups>scenario</groups>
                            <excludedGroups>none</excludedGroups>
                            <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Perfil opt-in para a EVIDENCIA de Virtual Threads do Grupo B (VirtualThreadsEvidenceIT,
             @Tag("vt") — padrao certo vs errado de concorrencia + fronteira de pinning JEP-491). Por que
             existe: o `verify` padrao EXCLUI o grupo "vt" (ver o failsafe acima) porque esses testes rodam
             micro-medicoes de concorrencia (throughput/percentis de latencia, bounded) e gravam JFR
             programatico (jdk.jfr.Recording / RecordingFile) — uteis como evidencia, mas nao deterministicos
             o bastante para a gate de CI. Este perfil INVERTE o filtro: roda APENAS os ITs com @Tag("vt")
             (<groups>) e sobrescreve o <excludedGroups> herdado com o mesmo sentinel "none" (uma tag
             inexistente) dos perfis `replication`/`scenarios` — um <excludedGroups></excludedGroups> VAZIO
             nao sobrescreveria o valor herdado "replication,scenario,vt" (o Maven faz merge da config do
             plugin, nao blanking), entao ambos os filtros se aplicariam e ZERO testes rodariam. Assim
             `mvn verify -Pvt` exercita a evidencia de Virtual Threads sob demanda. Espelha o perfil
             `scenarios` acima. -->
        <profile>
            <id>vt</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <!-- Run ONLY the vt group. An EMPTY <excludedGroups></excludedGroups> does NOT
                                 override the base <excludedGroups>replication,scenario,vt</excludedGroups>:
                                 Maven merges plugin configuration rather than blanking an inherited value, so
                                 both filters would apply and run ZERO tests. The sentinel "none" matches no
                                 @Tag, overriding the inherited exclusion so only @Tag("vt") ITs run. -->
                            <groups>vt</groups>
                            <excludedGroups>none</excludedGroups>
                            <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
